rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin";
    }

    function activeUser(uid) {
      return isOwner(uid)
        && (
          !exists(/databases/$(database)/documents/users/$(uid))
          || get(/databases/$(database)/documents/users/$(uid)).data.get("retentionUntil", null) == null
          || get(/databases/$(database)/documents/users/$(uid)).data.retentionUntil > request.time
        );
    }

    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isAdmin() || isOwner(uid);

      allow create: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.provider in ["email", "google"]
          && request.resource.data.keys().hasOnly([
            "uid", "name", "email", "phone", "photoURL", "provider",
            "createdAt", "retentionUntil", "lastLoginAt", "lastSeenAt",
            "profileImageChangedAt", "updatedAt"
          ])
        );

      allow update: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.provider == resource.data.provider
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "name", "phone", "photoURL", "lastLoginAt", "lastSeenAt",
                "profileImageChangedAt", "updatedAt"
              ])
              && (
                !request.resource.data.diff(resource.data).affectedKeys().hasAny(["photoURL"])
                || !resource.data.keys().hasAny(["profileImageChangedAt"])
                || (
                  request.resource.data.profileImageChangedAt is timestamp
                  && resource.data.profileImageChangedAt is timestamp
                  && (
                    request.time.year() > resource.data.profileImageChangedAt.year()
                    || (
                      request.time.year() == resource.data.profileImageChangedAt.year()
                      && request.time.month() > resource.data.profileImageChangedAt.month()
                    )
                  )
                )
              )
            )
            || (
              !resource.data.keys().hasAny(["createdAt", "retentionUntil"])
              && request.resource.data.createdAt is timestamp
              && request.resource.data.retentionUntil is timestamp
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "name", "phone", "photoURL", "createdAt", "retentionUntil",
                "lastLoginAt", "lastSeenAt", "profileImageChangedAt", "updatedAt"
              ])
            )
          )
        );

      allow delete: if isAdmin() || isOwner(uid);
    }

    match /categories/{id} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    match /products/{id} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    match /projects/{id} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    match /team/{id} {
      allow read: if isAdmin() || resource.data.get("published", true) == true;
      allow write: if isAdmin();
    }

    match /testimonials/{id} {
      allow read: if isAdmin()
        || resource.data.published == true
        || (signedIn() && resource.data.get("userId", "") == request.auth.uid);

      allow create: if isAdmin()
        || (
          signedIn()
          && request.resource.data.userId == request.auth.uid
          && activeUser(request.auth.uid)
          && request.resource.data.published == false
        );

      allow update: if isAdmin();

      allow delete: if isAdmin()
        || (signedIn() && resource.data.get("userId", "") == request.auth.uid);
    }

    match /enquiries/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.get("userId", "") == request.auth.uid);

      allow create: if isAdmin()
        || (
          signedIn()
          && request.resource.data.userId == request.auth.uid
          && activeUser(request.auth.uid)
        );

      allow update: if isAdmin();

      allow delete: if isAdmin()
        || (signedIn() && resource.data.get("userId", "") == request.auth.uid);
    }

    match /quotes/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.get("userId", "") == request.auth.uid);

      allow create: if isAdmin()
        || (
          signedIn()
          && request.resource.data.userId == request.auth.uid
          && activeUser(request.auth.uid)
        );

      allow update: if isAdmin();

      allow delete: if isAdmin()
        || (signedIn() && resource.data.get("userId", "") == request.auth.uid);
    }

    match /settings/{id} {
      allow read: if isAdmin() || id == "business";
      allow write: if isAdmin();
    }


    match /notifications/{id} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        || (
          signedIn()
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.read == false
          && request.resource.data.type in ["enquiry", "review"]
          && request.resource.data.keys().hasOnly([
            "id", "type", "title", "message", "link", "sourceId", "actorUid", "read", "createdAt"
          ])
          && (
            (
              request.resource.data.type == "enquiry"
              && exists(/databases/$(database)/documents/enquiries/$(request.resource.data.sourceId))
              && get(/databases/$(database)/documents/enquiries/$(request.resource.data.sourceId)).data.get("userId", "") == request.auth.uid
            )
            ||
            (
              request.resource.data.type == "review"
              && exists(/databases/$(database)/documents/testimonials/$(request.resource.data.sourceId))
              && get(/databases/$(database)/documents/testimonials/$(request.resource.data.sourceId)).data.get("userId", "") == request.auth.uid
            )
          )
        );

      allow update, delete: if isAdmin();
    }

    match /auditLogs/{id} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}